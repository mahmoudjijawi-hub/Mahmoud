# انسخ هذا الملف إلى .env ثم املأ القيم الخاصة بهذا المعهد.
# لا تضع أسراراً حقيقية داخل المستودع.

# مفتاح Django السري — غيّره في كل نشرة
SECRET_KEY=change-me-to-a-long-random-string

# التشغيل المحلي: True — الإنتاج: False
DEBUG=True

# True فقط بعد تركيب شهادة SSL، وإلا لن تُحفظ كوكيز الجلسة على HTTP
IS_HTTPS=False

# نطاقات مسموحة مفصولة بفاصلة (أضف نطاق السيرفر/ngrok في الإنتاج)
ALLOWED_HOSTS=localhost,127.0.0.1

# أصول الواجهة الأمامية المسموحة لـ CORS (مفصولة بفاصلة، بدون شرطة مائلة أخيرة)
# مع CORS_ALLOW_ALL_ORIGINS=True يُقبل أي أصل فرونت (الأسهل للتطوير).
# في الإنتاج: CORS_ALLOW_ALL_ORIGINS=False ثم ضع النطاق هنا فقط.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080,http://localhost:4200,http://127.0.0.1:4200,http://localhost:5500,http://127.0.0.1:5500

# مسار لوحة Django Admin العشوائي (بدون شرطات مائلة)
ADMIN_URL=secret-admin

# قاعدة البيانات — sqlite للتطوير المحلي، postgres للإنتاج
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# بيانات المدير الأولي (تُزرع بأمر seed_manager)
ADMIN_SPECIAL_NUMBER=7788990
ADMIN_USERNAME=ammar
# نفس كلمة المرور المستخدمة في طلب token بملف الـ Postman
ADMIN_PASSWORD=ammar12345ammar
ADMIN_FIRST_NAME=مدير
ADMIN_LAST_NAME=المعهد

# نطاق كوكي الجلسة — اتركه فارغاً للتطوير المحلي
SESSION_COOKIE_DOMAIN=

# تاريخ انتهاء اشتراك هذا المعهد (YYYY-MM-DD)
SUBSCRIPTION_EXPIRY_DATE=2027-12-31
