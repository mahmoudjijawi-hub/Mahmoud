# ============================================================
# ملف متغيرات البيئة — انسخه إلى .env أو الصقه في Render → Environment
# ============================================================

# مفتاح Django السري (غيّره في الإنتاج)
SECRET_KEY=change-me-to-a-long-random-string

# محلي: True | Render: False
DEBUG=False

# Render يستخدم HTTPS دائماً
IS_HTTPS=True

# ضع نطاق Render هنا بدون https:// (مثال: my-app.onrender.com)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CORS — True للتجربة السريعة مع الفرونت
CORS_ALLOW_ALL_ORIGINS=True
# إن عطّلت ALL_ORIGINS ضع عنوان الفرونت هنا
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# مسار لوحة Django Admin (بدون /)
ADMIN_URL=secret-admin

# قاعدة Neon PostgreSQL
DATABASE_URL=postgresql://neondb_owner:npg_4nOL7skoMpib@ep-late-block-ax2kg9c0.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require

# بديل: اتركه فارغاً واستخدم المتغيرات المنفصلة (مفيد لـ PostgreSQL محلية على Termux)
# DB_NAME=institutes
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=

# مدة بقاء الاتصال بالثواني (0 = اتصال جديد لكل طلب)
# DB_CONN_MAX_AGE=600
# فرض SSL حتى لو لم يُذكر في الرابط
# DB_SSL_REQUIRE=False

# القاعدة PostgreSQL دائماً. إن لم يكن المشغّل مثبّتاً يتوقف التطبيق برسالة واضحة
# بدل العمل صامتاً على قاعدة فارغة. للتجربة المؤقتة على SQLite فقط:
# ALLOW_SQLITE_FALLBACK=True

# بيانات المدير الأولي (بعد migrate + seed_manager)
ADMIN_SPECIAL_NUMBER=7788990
ADMIN_USERNAME=ammar
ADMIN_PASSWORD=ammar12345ammar
ADMIN_FIRST_NAME=مدير
ADMIN_LAST_NAME=المعهد

# كوكي الجلسة — اتركه فارغاً عادةً على Render
SESSION_COOKIE_DOMAIN=

# تاريخ انتهاء الاشتراك
SUBSCRIPTION_EXPIRY_DATE=2027-12-31
